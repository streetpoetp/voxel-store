<Project>
  <PropertyGroup>
    <HeroStudioSubmoduleRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Dependencies\hero-studio'))</HeroStudioSubmoduleRoot>
  </PropertyGroup>
  <Target Name="RequireHeroStudioSubmodule" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(HeroStudioSubmoduleRoot)/src/client/unity/Packages/hero.studio/hero.voxel/Tool~/Hero.Voxel.Tool/Hero.Voxel.Tool.csproj')"
           Text="Hero Studio provider is missing at Dependencies/hero-studio." />
  </Target>
</Project>
